# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit real secrets.
# In production, set these as actual environment variables (Docker secrets,
# systemd EnvironmentFile, CI/CD secret store, etc.) instead of shipping a
# .env file with the deployment.

# ------------------------------------------------------------------
# Database (SQL Server)
# ------------------------------------------------------------------
DB_URL=jdbc:sqlserver://YOUR_DB_HOST:1433;databaseName=AGRITRACK;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ------------------------------------------------------------------
# Cloudinary (image uploads)
# ------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Google Sign-In
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------
# Firebase (push notifications) — absolute path to a service-account JSON
# file. Leave empty locally to fall back to the bundled classpath resource.
# ------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=

# ------------------------------------------------------------------
# Email (SMTP) — used once a real Email OtpSender is implemented
# ------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_ADDRESS=no-reply@agritrack.app

# ------------------------------------------------------------------
# SMS — used once a real SMS OtpSender is implemented (e.g. Twilio, MSG91)
# ------------------------------------------------------------------
SMS_PROVIDER=none
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=AGRITR

# ------------------------------------------------------------------
# OTP behavior
# ------------------------------------------------------------------
# MUST be false in production once a real SMS/Email sender is wired in —
# true echoes the OTP back in the API response for testing without a
# provider (see AgriTrackBackend.OTP.OtpSender / LoggingOtpSender).
DEV_OTP_MODE=true
